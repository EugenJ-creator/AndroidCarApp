<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <objectAnimator
            android:propertyName="scaleX"
            android:valueTo="0.9"
            android:duration="100"/>
    </item>

    <item android:state_pressed="false">
        <objectAnimator
            android:propertyName="scaleX"
            android:valueTo="1"
            android:duration="100"/>
    </item>
</selector>