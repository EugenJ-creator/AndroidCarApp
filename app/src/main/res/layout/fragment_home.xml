            app:navGraph="@navigation/mobile_navigation"
            app:pointer_color="#0174DF"
            app:pointer_halo_color="#880174DF"
            app:progress="50"
            app:start_angle="180"
            app:use_custom_radii="true"
            tools:ignore="MissingConstraints" />


